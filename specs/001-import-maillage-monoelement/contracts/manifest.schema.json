{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aero25d:mesh:manifest:1",
  "title": "Manifeste canonique de résultat et reproduction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "operation",
    "status",
    "valid",
    "last_completed_stage",
    "created_at_utc",
    "generator",
    "environment",
    "source",
    "requested",
    "resolved",
    "geometry",
    "quality",
    "frames",
    "topology",
    "arrays",
    "files",
    "family"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "check",
        "mesh",
        "quality",
        "export",
        "family",
        "reproduce"
      ]
    },
    "status": {
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    },
    "last_completed_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision",
        "binary_sha256",
        "build_mode"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "build_mode": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "architecture",
        "compiler",
        "standard_library",
        "libraries",
        "numeric_options",
        "threads"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "compiler": {
          "type": "string"
        },
        "standard_library": {
          "type": "string"
        },
        "libraries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "numeric_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "units",
            "element_count",
            "point_count"
          ],
          "properties": {
            "file": {
              "$ref": "#/$defs/file"
            },
            "units": {
              "enum": [
                "m",
                "dimensionless"
              ]
            },
            "element_count": {
              "type": "integer",
              "minimum": 0
            },
            "point_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "requested": {
      "anyOf": [
        {
          "$ref": "#/$defs/file"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolved": {
      "anyOf": [
        {
          "$ref": "#/$defs/file"
        },
        {
          "type": "null"
        }
      ]
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/file"
        },
        {
          "type": "null"
        }
      ]
    },
    "quality": {
      "anyOf": [
        {
          "$ref": "#/$defs/file"
        },
        {
          "type": "null"
        }
      ]
    },
    "frames": {
      "anyOf": [
        {
          "$ref": "#/$defs/frames"
        },
        {
          "type": "null"
        }
      ]
    },
    "topology": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "file",
            "block_count",
            "interface_count"
          ],
          "properties": {
            "name": {
              "enum": [
                "thin",
                "thick"
              ]
            },
            "version": {
              "type": "string"
            },
            "file": {
              "$ref": "#/$defs/file"
            },
            "block_count": {
              "type": "integer",
              "minimum": 1
            },
            "interface_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "arrays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/array"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "family": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "study_id",
            "kind",
            "level",
            "rule",
            "reconstruction_sha256"
          ],
          "properties": {
            "study_id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "global_refinement",
                "parameter_diagnostic",
                "domain_variation"
              ]
            },
            "level": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "rule": {
              "type": "string"
            },
            "reconstruction_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "representation": {
      "anyOf": [
        {
          "$ref": "urn:aero25d:mesh:representation:1"
        },
        {
          "type": "null"
        }
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field_name": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "$ref": "#/$defs/file"
          },
          "association": {
            "enum": [
              "point",
              "cell",
              "face"
            ]
          },
          "tuple_count": {
            "type": "integer",
            "minimum": 0
          },
          "components": {
            "type": "integer",
            "minimum": 1
          },
          "frame": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "measured",
              "interpolated_for_visualization"
            ]
          },
          "source_association": {
            "enum": [
              "point",
              "cell",
              "face"
            ]
          }
        },
        "required": [
          "field_name",
          "file",
          "association",
          "tuple_count",
          "components",
          "frame",
          "units",
          "origin"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "interpolated_for_visualization"
                }
              }
            },
            "then": {
              "required": [
                "source_association"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "valid": {
            "const": true
          },
          "operation": {
            "enum": [
              "mesh",
              "quality",
              "export",
              "reproduce"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "type": "object"
          },
          "requested": {
            "type": "object"
          },
          "resolved": {
            "type": "object"
          },
          "geometry": {
            "type": "object"
          },
          "quality": {
            "type": "object"
          },
          "frames": {
            "type": "object"
          },
          "topology": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.1",
              "1.2"
            ]
          }
        }
      },
      "then": {
        "required": [
          "representation",
          "fields"
        ],
        "properties": {
          "arrays": {
            "items": {
              "required": [
                "association"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.1",
              "1.2"
            ]
          },
          "valid": {
            "const": true
          },
          "operation": {
            "enum": [
              "mesh",
              "quality",
              "export",
              "reproduce"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "representation": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vec2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "size_bytes",
        "sha256",
        "valid"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "valid": {
          "type": "boolean"
        }
      }
    },
    "array": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "file",
        "dtype",
        "endianness",
        "shape",
        "offset_bytes",
        "size_bytes",
        "frame"
      ],
      "properties": {
        "role": {
          "enum": [
            "global_nodes",
            "block_node_ids",
            "interface_node_ids"
          ]
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "dtype": {
          "enum": [
            "float64",
            "uint64"
          ]
        },
        "endianness": {
          "const": "little"
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "offset_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "frame": {
          "enum": [
            "N",
            "not_applicable"
          ]
        },
        "association": {
          "enum": [
            "point",
            "logical_node",
            "interface_node"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "global_nodes"
              }
            }
          },
          "then": {
            "properties": {
              "association": {
                "const": "point"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "block_node_ids"
              }
            }
          },
          "then": {
            "properties": {
              "association": {
                "const": "logical_node"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "interface_node_ids"
              }
            }
          },
          "then": {
            "properties": {
              "association": {
                "const": "interface_node"
              }
            }
          }
        }
      ]
    },
    "frames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_units",
        "normal_units",
        "work_units",
        "forward_order",
        "inverse_order",
        "original_chord",
        "xref",
        "sweep_deg",
        "translation",
        "scale",
        "global_y_axis",
        "extrusion_eta_axis",
        "quarter_chord_source"
      ],
      "properties": {
        "source_units": {
          "enum": [
            "m",
            "dimensionless"
          ]
        },
        "normal_units": {
          "enum": [
            "m",
            "dimensionless"
          ]
        },
        "work_units": {
          "const": "dimensionless"
        },
        "forward_order": {
          "const": [
            "S_to_N_sweep",
            "N_to_W_normalization"
          ]
        },
        "inverse_order": {
          "const": [
            "W_to_N_denormalization",
            "N_to_S_unsweep"
          ]
        },
        "original_chord": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "xref": {
          "type": "number"
        },
        "sweep_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "translation": {
          "$ref": "#/$defs/vec2"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "global_y_axis": {
          "$ref": "#/$defs/vec3"
        },
        "extrusion_eta_axis": {
          "$ref": "#/$defs/vec3"
        },
        "quarter_chord_source": {
          "$ref": "#/$defs/vec3"
        }
      }
    }
  }
}
