{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aero25d:mesh:campaign:1",
  "title": "Demande de campagne de maillage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "campaign_id",
    "profiles",
    "configurations",
    "expansion",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "kind": {
      "const": "mesh_campaign"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "input",
          "units"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "enum": [
              "m",
              "dimensionless"
            ]
          },
          "hints": {
            "$ref": "urn:aero25d:mesh:configuration:1#/properties/hints"
          }
        }
      },
      "minItems": 1
    },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "config"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "expansion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "profile_ids",
            "sweeps_deg",
            "configuration_ids",
            "levels"
          ],
          "properties": {
            "mode": {
              "const": "cartesian"
            },
            "profile_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "sweeps_deg": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "configuration_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "levels": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "points"
          ],
          "properties": {
            "mode": {
              "const": "points"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "profile_id",
                  "sweep_deg",
                  "configuration_id",
                  "level"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "profile_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sweep_deg": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 50
                  },
                  "configuration_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "incidence_deg": {
                    "type": "number"
                  }
                }
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "on_failure"
      ],
      "properties": {
        "mode": {
          "const": "sequential"
        },
        "on_failure": {
          "enum": [
            "continue",
            "stop"
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "future_flight": {
          "type": "object"
        }
      }
    }
  }
}
